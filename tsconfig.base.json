{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Language and Environment
    "lib": ["ES2022"],
    "target": "ES2022",

    // Modules
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "isolatedModules": true,


    // Emit - disabled, tsx runs TypeScript directly
    "noEmit": true,

    // Type Checking
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,

    // Interop Constraints
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,

    // Projects
    "composite": false,
    "incremental": true,

    // Import aliases
    "paths": {
      "#scripts/*": ["./scripts/*"]
    }
  },
  // IsEnum.spec deliberately declares native enums (incl. numeric reverse-mapping and heterogeneous cases) to test IsEnum against them, which erasableSyntaxOnly forbids; it stays covered by vitest.
  "exclude": ["**/IsEnum.spec.ts"]
}
