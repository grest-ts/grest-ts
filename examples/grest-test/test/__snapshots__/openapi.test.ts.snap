                                  },
                                  "street": {
                                    "description": "Street address",
                                    "example": "123 Main St",
                                    "minLength": 1,
                                    "type": "string",
                                  },
                                  "zip": {
                                    "description": "Postal code",
                                    "example": "10001",
                                    "type": "string",
                                  },
                                },
                                "required": [
                                  "street",
                                  "city",
                                  "country",
                                ],
                                "title": "Postal address",
                                "type": "object",
                              },
                              "bio": {
                                "description": "Short biography",
                                "maxLength": 500,
                                "type": "string",
                              },
                              "coordinates": {
                                "description": "Location as [latitude, longitude]",
                                "items": false,
                                "maxItems": 2,
                                "minItems": 2,
                                "prefixItems": [
                                  {
                                    "description": "Decimal degrees (-90 to 90)",
                                    "example": 59.437,
                                    "maximum": 90,
                                    "minimum": -90,
                                    "title": "Latitude",
                                    "type": "number",
                                  },
                                  {
                                    "description": "Decimal degrees (-180 to 180)",
                                    "example": 24.754,
                                    "maximum": 180,
                                    "minimum": -180,
                                    "title": "Longitude",
                                    "type": "number",
                                  },
                                ],
                                "type": "array",
                              },
                              "deprecatedField": {
                                "deprecated": true,
                                "description": "Use email instead",
                                "type": "string",
                              },
                              "email": {
                                "example": "user@example.com",
                                "title": "Email address",
                                "type": "string",
                              },
                              "id": {
                                "example": "usr_abc123",
                                "minLength": 1,
                                "type": "string",
