    "/api/showcase/users/{id}/avatar": {
      "get": {
        "operationId": "ShowcaseApi_downloadAvatar",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "jpeg",
              "enum": [
                "jpeg",
                "png",
                "webp",
              ],
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "format": "binary",
                  "type": "string",
                },
              },
            },
            "description": "File download",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=<name>",
                "schema": {
                  "example": "attachment; filename=document.pdf",
                  "minLength": 1,
                  "type": "string",
                },
              },
            },
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error_ResourceNotFound",
                },
              },
            },
            "description": "RESOURCE_NOT_FOUND",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=<name>",
                "schema": {
                  "example": "attachment; filename=document.pdf",
                  "minLength": 1,
                  "type": "string",
                },
              },
            },
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error_ServerError",
                },
              },
            },
            "description": "SERVER_ERROR",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=<name>",
                "schema": {
                  "example": "attachment; filename=document.pdf",
                  "minLength": 1,
                  "type": "string",
                },
              },
            },
          },
        },
        "security": [
          {
            "BearerToken": [],
          },
        ],
        "summary": "Download Avatar",
        "tags": [
          "ShowcaseApi",
        ],
      },
      "post": {
        "operationId": "ShowcaseApi_uploadAvatar",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "avatar": {
                    "description": "Profile image — JPEG, PNG, or WebP, max 2 MB",
                    "format": "binary",
                    "type": "string",
                  },
                  "crop": {
                    "description": "JSON-serialised crop rectangle: {x,y,w,h}",
                    "type": "string",
                  },
                },
                "required": [
                  "avatar",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "additionalProperties": false,
                      "properties": {
                        "height": {
                          "minimum": 0,
                          "type": "integer",
                        },
                        "url": {
                          "$ref": "#/components/schemas/URL",
                        },
                        "width": {
                          "minimum": 0,
                          "type": "integer",
                        },
                      },
                      "required": [
                        "url",
                        "width",
                        "height",
                      ],
                      "type": "object",
                    },
                    "success": {
                      "enum": [
                        true,
                      ],
                      "type": "boolean",
                    },
                    "type": {
                      "enum": [
                        "OK",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "success",
                    "type",
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error_ValidationError",
                },
              },
            },
            "description": "VALIDATION_ERROR",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error_ServerError",
                },
              },
            },
            "description": "SERVER_ERROR",
          },
        },
        "security": [
          {
            "BearerToken": [],
          },
        ],
        "summary": "Upload Avatar",
        "tags": [
          "ShowcaseApi",
        ],
      },
    },
  },
}
