                          "description": "Registration date",
                          "example": "2024-01-15",
                          "title": "Date",
                          "type": "string",
                        },
                        "language": {
                          "description": "ISO 639-1",
                          "example": "en",
                          "title": "Language code",
                          "type": "string",
                        },
                        "lastActiveAt": {
                          "description": "Seconds since Unix epoch (year 1970–3000)",
                          "example": 1700000000,
                          "maximum": 32503680000,
                          "minimum": 0,
                          "title": "Unix timestamp in seconds",
                          "type": "integer",
                        },
                        "locale": {
